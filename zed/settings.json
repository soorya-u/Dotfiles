{
  // Dock Settings
  "agent_servers": {
    "claude-acp": {
      "type": "registry",
    },
  },
  "lsp": {
    "vtsls": {
      "settings": {
        "typescript": {
          "updateImportsOnFileMove": {
            "enabled": "always",
          },
        },
        "javascript": {
          "updateImportsOnFileMove": {
            "enabled": "always",
          },
        },
      },
      "enable_lsp_tasks": true,
    },
  },
  "format_on_save": "off",
  "git_panel": { "dock": "right" },
  "project_panel": { "dock": "right" },
  "agent": { "dock": "left" },

  // Themes
  "icon_theme": "Material Icon Theme",
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "One Dark Pro",
  },

  // Preferences
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "base_keymap": "VSCode",

  // Terminal Settings
  "terminal": {
    "font_family": "JetBrainsMono Nerd Font",
    "cursor_shape": "underline",
  },

  // Disable Telemetry
  "telemetry": { "metrics": false },

  // Vim Settings
  "vim_mode": true,
  "relative_line_numbers": "enabled",
  "vim": {
    "toggle_relative_line_numbers": true,
  },

  // Language Settings
  "languages": {
    "Python": {
      "language_servers": ["basedpyright", "ruff"],
      "formatter": [{ "language_server": { "name": "ruff" } }],
    },
  },
}
